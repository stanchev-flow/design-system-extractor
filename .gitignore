venv/
__pycache__/
*.py[cod]
.DS_Store
tmp/
temp/
.env
.env.*
!.env.example
node_modules/
dist/
*.tsbuildinfo
# setuptools build metadata, regenerated by every `pip install -e .`.
# src/screenshot_to_template.egg-info/ was committed before this rule and has since
# been untracked (`git rm -r --cached`), so a fresh clone stays clean through install.
*.egg-info/

# Large generated artifacts (runs, screenshots, viewer data) — regenerate locally.
#
# runs/remote/ and runs/hubspot-v2/ were committed before this rule existed and
# are still tracked (~248 MB). They are frozen legacy snapshots, not current
# output: do not treat them as up to date, and do not use them as the template
# for what a run should contain. Untracking them is a separate, unmade decision.
# For shareable results, publish a bundle into artifacts/published/ instead.
runs/
screenshots/
viewer-data/
handoff/v302-fieldnote/
.pytest_cache/

# BEGIN studio-subset (tools/track_studio_subset.py) — do not hand-edit
# Targeted exceptions to the runs/ and screenshots/ rules above, so a clean
# clone has real Studio projects to open. Regenerate, never hand-edit:
#   ./venv/bin/python tools/track_studio_subset.py --run runs/<project> --write-gitignore
