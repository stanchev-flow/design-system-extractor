{
  "layout": "footer",
  "brand": "HubSpot",
  "composition_mode": true,
  "neverDo": {
    "never-typographic-primary": false,
    "never-zero-radius": true,
    "never-blur-hero": true,
    "never-orange-text-link": true,
    "never-allcaps-headings": true
  },
  "neverDo_allowed": [],
  "fidelity": {
    "pass": false,
    "checks": {
      "Surface = brand surface/inverse (#1f1f1f)": true,
      "Brand accent surfaced (#ff4800)": true,
      "Brand assets present (not placeholder)": false
    }
  },
  "slop": {
    "pass": false,
    "checks": {
      "No default/system display font": true,
      "No off-palette hex colors": true,
      "No lorem/placeholder copy": true,
      "All brand image assets present": false,
      "Rounding matches brand radius scale": false,
      "Webfonts loaded (no silent system fallback)": true
    }
  },
  "invariants": {
    "mode": "hard",
    "pass": false,
    "checks": {
      "single-accent": true,
      "primitive-only": true,
      "rhythm": true,
      "data-composition": true,
      "slot-resolution": true,
      "text-contrast": true,
      "decoration-salience": true,
      "occlusion": true,
      "band-attribution": true,
      "alignment-resolution": true,
      "media-registration": true,
      "interaction-contrast": true,
      "token-provenance": false
    },
    "details": {
      "text-contrast": "37 text elements measured against their effective background (surface + decoration layer); worst = sec-0/c-eyebrow('Introducing') at 4.85 (floor 4.5); skipped=0",
      "decoration-salience": "no decoration layers (ghost word / watermark) in this render"
    }
  },
  "overall": false
}
